{
  "title": "Tor Bridge Client",
  "uid": "tor",
  "version": 3,
  "tags": ["tor", "bridge"],
  "timezone": "browser",
  "editable": true,
  "refresh": "10s",
  "schemaVersion": 39,
  "panels": [
    {
      "id": 1,
      "title": "Circuit Established",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "targets": [{
        "expr": "tor_bridge_circuit_established"
      }],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "red", "value": 0 },
              { "color": "green", "value": 1 }
            ]
          }
        }
      }
    },
    {
      "id": 2,
      "title": "Bootstrap Progress",
      "type": "gauge",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "targets": [{
        "expr": "tor_bridge_bootstrap_progress"
      }],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "orange", "value": 0 },
              { "color": "yellow", "value": 25 },
              { "color": "green", "value": 75 }
            ]
          }
        }
      }
    },
    {
      "id": 3,
      "title": "Bridge Up",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "targets": [{
        "expr": "tor_bridge_up"
      }],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "red", "value": 0 },
              { "color": "green", "value": 1 }
            ]
          }
        }
      }
    },
    {
      "id": 4,
      "title": "Configured Bridges",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 0 },
      "targets": [{
        "expr": "tor_bridge_configured_total"
      }],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "steps": [{ "color": "blue" }] }
        }
      }
    },
    {
      "id": 5,
      "title": "Reachable Bridges",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 4 },
      "targets": [{
        "expr": "tor_bridge_reachable_total"
      }],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "red", "value": 0 },
              { "color": "green", "value": 1 }
            ]
          }
        }
      }
    },
    {
      "id": 6,
      "title": "Unreachable Bridges",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 4 },
      "targets": [{
        "expr": "tor_bridge_unreachable_total"
      }],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "green", "value": 0 },
              { "color": "orange", "value": 1 }
            ]
          }
        }
      }
    },
    {
      "id": 7,
      "title": "WebTunnel Configured",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 4 },
      "targets": [{
        "expr": "count(tor_bridge_info{transport=\"webtunnel\"})"
      }],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "steps": [{ "color": "blue" }] }
        }
      }
    },
    {
      "id": 8,
      "title": "WebTunnel Reachable",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 4 },
      "targets": [{
        "expr": "count(tor_bridge_info{transport=\"webtunnel\",status=~\"up|reachable\"})"
      }],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "steps": [
              { "color": "red", "value": 0 },
              { "color": "green", "value": 1 }
            ]
          }
        }
      }
    },
    {
      "id": 9,
      "title": "Bridges by Transport",
      "type": "barchart",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [{
        "expr": "count by (transport) (tor_bridge_info)",
        "legendFormat": "{{transport}}"
      }],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" }
        }
      }
    },
    {
      "id": 10,
      "title": "Bridge Details",
      "type": "table",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [{
        "expr": "tor_bridge_info",
        "format": "table",
        "instant": true
      }],
      "transformations": [
        {
          "id": "sortBy",
          "options": {
            "fields": "<status>",
            "reverse": true
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true,
              "__name__": true,
              "instance": true,
              "job": true,
              "fingerprint": true
            },
            "indexByName": {
              "host": 0,
              "transport": 1,
              "fingerprint_short": 2,
              "status": 3
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "displayMode": "auto",
            "align": "left"
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "status" },
            "properties": [
              { "id": "custom.cellOptions", "value": { "type": "auto", "mode": "basic" } },
              { "id": "displayName", "value": "Status" }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "host" },
            "properties": [
              { "id": "displayName", "value": "Host" }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "transport" },
            "properties": [
              { "id": "displayName", "value": "Transport" }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "fingerprint_short" },
            "properties": [
              { "id": "displayName", "value": "Fingerprint" }
            ]
          }
        ]
      }
    }
  ]
}