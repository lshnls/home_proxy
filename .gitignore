--- .gitignore (原始)
# Docker volumes
tor/data/
tor/data/*

# IDE
.vscode/
.idea/
*.code-workspace

squid/ssl

+++ .gitignore (修改后)
# Configuration and system files
*.conf.swp
*.conf.bak
*.log
*.tmp

# Environment files
.env
.env.local
*.env.*

# Cache and temporary directories
.cache/
tmp/
temp/

# Backup files
*~
*.bak
*.backup

# OS-specific files
.DS_Store
Thumbs.db

# Editor files
.vscode/
.idea/
*.swp
*.swo

# Build artifacts (if any)
build/
dist/
target/

# Dependencies (if any)
node_modules/
__pycache__/
*.pyc
*.pyo
*.pyd

# Compression and archives
*.zip
*.gz
*.tar
*.tgz
*.bz2
*.xz
*.7z
*.rar
*.zst
*.lz4
*.lzh
*.cab
*.arj
*.rpm
*.deb
*.Z
*.lz
*.lzo
*.tar.gz
*.tar.bz2
*.tar.xz
*.tar.zst

# Coverage reports
coverage/
htmlcov/
.coverage

# Python specific
*.pyc
*.pyo
__pycache__/
.pytest_cache/
.mypy_cache/

# Node.js specific
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Java specific
*.class
*.jar
*.war
*.ear
target/
.gradle/
build/

# C/C++ specific
*.o
*.obj
*.exe
*.dll
*.so
*.a
*.out

# Go specific
*.exe
*.exe~
*.dll
*.so
*.dylib
*.test
*.prof

# Ruby specific
*.gem
*.rbc
.bundle/
vendor/bundle/
.ruby-version
.rbenv-vars

# Rust specific
target/
Cargo.lock

# Julia specific
.julia/
*.ji

# Zig specific
zig-cache/
zig-out/

# Gradle specific
.gradle/
build/

# Maven specific
target/
*.jar
*.war
*.ear

# Docker specific
.dockerenv
Dockerfile.*
docker-compose.*

# Temporary files
*.tmp
*.temp
*.log
*.swp
*.swo

# Sensitive files
config/secrets.*
secrets/
credentials.json
.env.local
.env.production
.env.development

# Squid specific (from your config directory)
squid/cache/
squid/logs/
squid/log/
squid/access.log
squid/cache.log
squid/store.log
squid/*.log
squid/core.*

# Squid cache directories
**/squid/*/cache/
**/squid/*/logs/
**/squid/*/log/

# Any other cache or log files in squid config
squid/config/*.log
squid/config/*_log
squid/config/cache_dir/
squid/config/core.*
