# Прозрачное проксирование клиентов из LAN 192.168.1.0/24
# Squid в Docker слушает опубликованные порты хоста:
#   8081 -> http_port ... intercept
#   8082 -> https_port ... intercept ssl-bump

*nat
:PREROUTING ACCEPT [0:0]
:INPUT ACCEPT [0:0]
:OUTPUT ACCEPT [0:0]
:POSTROUTING ACCEPT [0:0]

# Не трогаем loopback
-A PREROUTING -i lo -j RETURN
-A PREROUTING -i enp0s31f6 -d 192.168.1.0/24 -j RETURN
-A PREROUTING -i enp0s31f6 -d 10.0.0.0/8 -j RETURN
-A PREROUTING -i enp0s31f6 -d 172.16.0.0/12 -j RETURN
-A PREROUTING -i enp0s31f6 -d 192.168.0.0/16 -j RETURN
-A PREROUTING -i enp0s31f6 -d 127.0.0.0/8 -j RETURN

# Прозрачное перенаправление HTTP/HTTPS в Squid
-A PREROUTING -i enp0s31f6 -p tcp --dport 80 -j REDIRECT --to-ports 8081
-A PREROUTING -i enp0s31f6 -p tcp --dport 443 -j REDIRECT --to-ports 8082
COMMIT


*filter
:INPUT ACCEPT [0:0]
:FORWARD DROP [0:0]
:OUTPUT ACCEPT [0:0]

# Разрешаем уже установленные соединения
-A FORWARD -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT

# loopback
-A INPUT -i lo -j ACCEPT

# уже установленные соединения
-A INPUT -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT

# SSH
-A INPUT -p tcp --dport 22 -j ACCEPT

# DNS
-A INPUT -p udp --dport 53 -j ACCEPT
-A INPUT -p tcp --dport 53 -j ACCEPT

# Privoxy
-A INPUT -p tcp --dport 8118 -j ACCEPT

# Tor SOCKS
-A INPUT -p tcp --dport 9050 -j ACCEPT

# Squid
-A INPUT -p tcp --dport 3128 -j ACCEPT
-A INPUT -p tcp --dport 8081 -j ACCEPT
-A INPUT -p tcp --dport 8082 -j ACCEPT

# Nginx
-A INPUT -p tcp --dport 443 -j ACCEPT

-A INPUT -p tcp --dport 5000 -j ACCEPT


# Разрешаем клиентам LAN выход через хост
-A FORWARD -i enp0s31f6 -j ACCEPT

# Блокируем QUIC, чтобы HTTPS шел через TCP/443 (и попадал в прокси)
-A FORWARD -i enp0s31f6 -p udp --dport 443 -j DROP
COMMIT